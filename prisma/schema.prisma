// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

// create the user data base Table/model; 

model UserMosel {
  id String @id @default(uuid())

  username String

  email String @unique

  address String
}
